                      </span>
                      {message.confidence && (
                        <span className="text-xs text-gray-500">
                          {(message.confidence * 100).toFixed(0)}% confidence
                        </span>
                      )}
                    </div>
                    <div className="flex space-x-2">
                      <button
                        onClick={() => copyToClipboard(message.content, index)}
