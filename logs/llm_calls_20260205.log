    sample_text = text[:1000] # Take first 1000 chars for simplicity
    if len(sample_text) > chunk_size:
        splits.append({"chunk_id": "c001", "text": sample_text[:chunk_size], "token_count": count_tokens(sample_text[:chunk_size]), "char_range": (0, chunk_ # Truncate individual chapter if extremely huge
            
