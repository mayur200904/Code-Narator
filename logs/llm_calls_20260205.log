# Vector DB
CHROMA_PERSIST_DIRECTORY=./chroma_db

# Caching
REDIS_URL=redis://localhost:6379
CACHE_TTL=86400  # 24 hours

# Application
DEBUG=true
LOG_LEVEL=info
```

