GITHUB_TOKEN=<GITHUB_TOKEN>

# Gemini (auto-selected if GEMINI_API_KEY or GEMINI_PROJECT_ID is present)
GEMINI_API_KEY=<GEMINI_API_KEY>
GEMINI_PROJECT_ID=<GEMINI_PROJECT_ID>
GEMINI_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash

# OpenAI-compatible mode (default primary when LLM_PROVIDER is not set)
# Runtime order is OPENROUTER first, then GEMINI fallback.
LLM_PROVIDER=OPENROUTER
LLM_PROVIDER_PRIORITY=GEMINI,OPENROUTER
OPENROUTER_MODEL=<OPENROUTER_MODEL>
OPENROUTER_BASE_URL=https://openrouter.ai/api
OPENROUTER_API_KEY=<OPENROUTER_API_KEY>

LOG_DIR=logs

# Large-repo performance tuning (optional)
FAST_MAX_FILES=220
FAST_CRAWL_MAX_FILES=450
FAST_LARGE_REPO_FILE_THRESHOLD=140
FAST_MAX_ABSTRACTIONS=6
FAST_MAX_FILE_CHARS=3500
FAST_MAX_CONTEXT_CHARS=120000
FAST_REL_MAX_CONTEXT_CHARS=50000
FAST_CHAPTER_MAX_FILE_CHARS=1400
FAST_CHAPTER_MAX_CONTEXT_CHARS=30000

# LLM reliability tuning (optional)
GEMINI_MAX_RETRIES=2
GEMINI_BASE_RETRY_DELAY_SEC=3
GEMINI_MAX_RETRY_DELAY_SEC=12
LLM_CONNECT_TIMEOUT_SEC=10
LLM_READ_TIMEOUT_SEC=90
LLM_PROVIDER_UNAVAILABLE_COOLDOWN_SEC=180
LLM_PROVIDER_RATE_LIMIT_COOLDOWN_SEC=900
LLM_PROVIDER_NETWORK_COOLDOWN_SEC=180
